<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Log Cleanup: daily -->
        <record id="cron_kwtsms_log_cleanup" model="ir.cron">
            <field name="name">kwtSMS: Cleanup Old Logs</field>
            <field name="model_id" ref="model_kwtsms_sms_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_cleanup_old_logs()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

        <!-- Refresh All: every 6 hours (balance, sender IDs, coverage) -->
        <record id="cron_kwtsms_balance_refresh" model="ir.cron">
            <field name="name">kwtSMS: Refresh All</field>
            <field name="model_id" ref="model_kwtsms_gateway_config"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_all()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
        </record>

        <!-- Admin: Low Stock Alert (daily) -->
        <record id="cron_kwtsms_admin_low_stock" model="ir.cron">
            <field name="name">kwtSMS: Low Stock Alert</field>
            <field name="model_id" ref="model_kwtsms_gateway_config"/>
            <field name="state">code</field>
            <field name="code">model._cron_admin_low_stock_alert()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

        <!-- Admin: Overdue Invoices (daily) -->
        <record id="cron_kwtsms_admin_overdue_invoices" model="ir.cron">
            <field name="name">kwtSMS: Overdue Invoice Alert</field>
            <field name="model_id" ref="model_kwtsms_gateway_config"/>
            <field name="state">code</field>
            <field name="code">model._cron_admin_overdue_invoices()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
    </data>
</odoo>
