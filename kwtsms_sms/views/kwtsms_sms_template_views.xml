<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- SMS Template Tree View -->
    <record id="view_kwtsms_sms_template_tree" model="ir.ui.view">
        <field name="name">kwtsms.sms.template.tree</field>
        <field name="model">kwtsms.sms.template</field>
        <field name="arch" type="xml">
            <list string="SMS Templates">
                <field name="name"/>
                <field name="event_type"/>
                <field name="lang"/>
                <field name="char_count"/>
                <field name="page_count"/>
                <field name="is_unicode" string="Unicode"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- SMS Template Form View -->
    <record id="view_kwtsms_sms_template_form" model="ir.ui.view">
        <field name="name">kwtsms.sms.template.form</field>
        <field name="model">kwtsms.sms.template</field>
        <field name="arch" type="xml">
            <form string="SMS Template">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Template Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="event_type"/>
                            <field name="lang"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="model_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Message Body">
                        <field name="body" nolabel="1" placeholder="Enter SMS message..."/>
                    </group>
                    <group string="SMS Info">
                        <group>
                            <field name="char_count"/>
                            <field name="page_count"/>
                            <field name="is_unicode"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <strong>Available Placeholders:</strong>
                        {order_name}, {customer_name}, {amount}, {company_name},
                        {picking_name}, {tracking_ref}
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SMS Template Search View -->
    <record id="view_kwtsms_sms_template_search" model="ir.ui.view">
        <field name="name">kwtsms.sms.template.search</field>
        <field name="model">kwtsms.sms.template</field>
        <field name="arch" type="xml">
            <search string="Search Templates">
                <field name="name"/>
                <field name="event_type"/>
                <separator/>
                <filter string="English" name="filter_en"
                        domain="[('lang', '=', 'en')]"/>
                <filter string="Arabic" name="filter_ar"
                        domain="[('lang', '=', 'ar')]"/>
                <separator/>
                <filter string="Active" name="filter_active"
                        domain="[('active', '=', True)]"/>
                <filter string="Archived" name="filter_archived"
                        domain="[('active', '=', False)]"/>
                <separator/>
                <group>
                    <filter string="Event Type" name="group_event"
                            context="{'group_by': 'event_type'}"/>
                    <filter string="Language" name="group_lang"
                            context="{'group_by': 'lang'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- SMS Template Action -->
    <record id="action_kwtsms_sms_template" model="ir.actions.act_window">
        <field name="name">SMS Templates</field>
        <field name="res_model">kwtsms.sms.template</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>
</odoo>
