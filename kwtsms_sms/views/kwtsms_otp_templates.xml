<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="kwtsms_otp_verify_template" name="kwtSMS OTP Verify">
        <t t-call="web.login_layout">
            <form method="POST" action="/kwtsms/otp/verify" class="oe_login_form">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                <div class="mb-3 text-center">
                    <h4>Verify Your Identity</h4>
                    <p class="text-muted">
                        Enter the verification code sent to your phone
                        <t t-if="phone_masked">
                            ending in <strong t-esc="phone_masked"/>
                        </t>
                    </p>
                </div>

                <div t-if="error" class="alert alert-danger mb-3" role="alert">
                    <t t-esc="error"/>
                </div>

                <div t-if="message" class="alert alert-info mb-3" role="alert">
                    <t t-esc="message"/>
                </div>

                <div class="mb-3">
                    <label for="otp_code" class="form-label">Verification Code</label>
                    <input type="text" name="otp_code" id="otp_code"
                           class="form-control form-control-lg text-center"
                           maxlength="8" pattern="[0-9]*" inputmode="numeric"
                           autocomplete="one-time-code" autofocus="autofocus"
                           placeholder="Enter code" required="required"/>
                </div>

                <div class="mb-3 d-grid">
                    <button type="submit" class="btn btn-primary btn-lg">Verify</button>
                </div>

                <div class="text-center">
                    <t t-if="can_resend">
                        <form method="POST" action="/kwtsms/otp/resend" class="d-inline">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <button type="submit" class="btn btn-link">Resend Code</button>
                        </form>
                    </t>
                    <t t-else="">
                        <span class="text-muted">
                            Resend available in <span id="cooldown_timer" t-att-data-seconds="cooldown_remaining">
                                <t t-esc="cooldown_remaining"/>
                            </span>s
                        </span>
                    </t>
                </div>

                <div class="text-center mt-3">
                    <a href="/web/session/logout" class="btn btn-link text-muted">Cancel</a>
                </div>
            </form>
        </t>
    </template>

    <!-- Extend login page to add phone login option -->
    <template id="kwtsms_login_phone_option" inherit_id="web.login" name="kwtSMS Phone Login">
        <xpath expr="//div[@id='oe_structure_login_bottom']" position="inside">
            <t t-if="request.env['ir.config_parameter'].sudo().get_param('kwtsms.otp_passwordless', 'False') == 'True'">
                <div class="text-center my-3">
                    <span class="text-muted">or</span>
                </div>
                <form method="POST" action="/kwtsms/otp/phone-login" class="oe_login_form">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="mb-3">
                        <label for="phone" class="form-label">Login with Phone</label>
                        <div class="input-group">
                            <span class="input-group-text">+</span>
                            <input type="text" name="country_code"
                                   class="form-control" style="max-width: 80px;"
                                   t-att-value="request.env['ir.config_parameter'].sudo().get_param('kwtsms.default_country_code', '965')"
                                   placeholder="965"/>
                            <input type="tel" name="phone"
                                   class="form-control"
                                   placeholder="Phone number"
                                   inputmode="numeric"/>
                        </div>
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-outline-primary">
                            Send Verification Code
                        </button>
                    </div>
                    <t t-if="request.params.get('kwtsms_phone_error') == 'invalid'">
                        <div class="alert alert-danger mt-2" role="alert">
                            Please enter a valid phone number.
                        </div>
                    </t>
                    <t t-if="request.params.get('kwtsms_phone_sent')">
                        <div class="alert alert-info mt-2" role="alert">
                            If this number is registered, a code has been sent.
                        </div>
                    </t>
                    <t t-if="request.params.get('kwtsms_phone_error') == 'send_failed'">
                        <div class="alert alert-danger mt-2" role="alert">
                            Could not send code. Please try again.
                        </div>
                    </t>
                </form>
            </t>
        </xpath>
    </template>
</odoo>
