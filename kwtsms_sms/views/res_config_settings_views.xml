<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Settings Page -->
    <record id="view_res_config_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.kwtsms</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="kwtSMS Gateway"
                     name="kwtsms_sms"
                     groups="base.group_system">

                    <!-- Dashboard -->
                    <block title="Dashboard" name="kwtsms_dashboard">
                        <setting id="kwtsms_dashboard_content" string="Gateway Overview">
                            <!-- Status indicators row -->
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <!-- Gateway enabled/disabled -->
                                <div invisible="not kwtsms_enabled"
                                     class="kwtsms_status_badge kwtsms_enabled">
                                    <span class="kwtsms_status_dot"/>
                                    Gateway Enabled
                                </div>
                                <div invisible="kwtsms_enabled"
                                     class="kwtsms_status_badge kwtsms_disabled">
                                    <span class="kwtsms_status_dot"/>
                                    Gateway Disabled
                                </div>
                                <!-- Connection status -->
                                <div invisible="kwtsms_api_status != 'connected'"
                                     class="kwtsms_status_badge kwtsms_connected">
                                    <span class="kwtsms_status_dot"/>
                                    Connected
                                </div>
                                <div invisible="kwtsms_api_status != 'error'"
                                     class="kwtsms_status_badge kwtsms_disconnected">
                                    <span class="kwtsms_status_dot"/>
                                    Error
                                </div>
                                <div invisible="kwtsms_api_status != 'not_configured'"
                                     class="kwtsms_status_badge kwtsms_not_configured">
                                    <span class="kwtsms_status_dot"/>
                                    Not Configured
                                </div>
                                <!-- Red test mode pill, only visible when test mode ON -->
                                <div invisible="not kwtsms_test_mode"
                                     class="kwtsms_test_mode_pill">
                                    TEST MODE
                                </div>
                            </div>

                            <!-- Balance + Sender ID row -->
                            <div class="kwtsms_top_row mb-3">
                                <div class="kwtsms_balance_box">
                                    <div>
                                        <div class="kwtsms_balance_label">Balance</div>
                                        <div class="kwtsms_balance_value">
                                            <field name="kwtsms_balance_available" readonly="1"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="kwtsms_sender_card">
                                    <div class="kwtsms_sender_card_label">SENDER ID</div>
                                    <div class="kwtsms_sender_card_value">
                                        <field name="kwtsms_current_sender" readonly="1"
                                               style="display: inline; white-space: nowrap;"/>
                                    </div>
                                </div>
                            </div>

                            <!-- SMS analytics cards (all on one row) -->
                            <div class="kwtsms_stat_row mb-3">
                                <div class="kwtsms_stat_card">
                                    <div class="kwtsms_stat_value">
                                        <field name="kwtsms_sms_today" readonly="1"/>
                                    </div>
                                    <div class="kwtsms_stat_label">Sent Today</div>
                                </div>
                                <div class="kwtsms_stat_card">
                                    <div class="kwtsms_stat_value">
                                        <field name="kwtsms_sms_this_week" readonly="1"/>
                                    </div>
                                    <div class="kwtsms_stat_label">This Week</div>
                                </div>
                                <div class="kwtsms_stat_card">
                                    <div class="kwtsms_stat_value">
                                        <field name="kwtsms_sms_this_month" readonly="1"/>
                                    </div>
                                    <div class="kwtsms_stat_label">This Month</div>
                                </div>
                                <div class="kwtsms_stat_card kwtsms_stat_failed">
                                    <div class="kwtsms_stat_value">
                                        <field name="kwtsms_sms_failed" readonly="1"/>
                                    </div>
                                    <div class="kwtsms_stat_label">Failed (30d)</div>
                                </div>
                            </div>

                            <!-- Last updated pill -->
                            <div class="kwtsms_last_updated_pill"
                                 invisible="not kwtsms_last_verified">
                                <i class="fa fa-clock-o"/>
                                <span>Last Updated:</span>
                                <field name="kwtsms_last_verified" readonly="1"
                                       style="display: inline; white-space: nowrap;"/>
                            </div>
                            <div class="kwtsms_last_updated_pill kwtsms_last_updated_na"
                                 invisible="kwtsms_last_verified">
                                <i class="fa fa-clock-o"/>
                                <span>Last Updated: N/A</span>
                            </div>

                            <!-- Hidden fields needed for conditional visibility -->
                            <field name="kwtsms_api_status" invisible="1"/>

                            <!-- Error display (only when status is error, not on initial load) -->
                            <div invisible="kwtsms_api_status != 'error'" class="text-danger mt-2"
                                 style="font-size: 0.85em;">
                                <field name="kwtsms_api_error" readonly="1"/>
                            </div>
                        </setting>
                    </block>

                    <!-- General Settings -->
                    <block title="General Settings" name="kwtsms_general">
                        <setting id="kwtsms_enabled_setting"
                                 string="Enable kwtSMS Gateway"
                                 help="Master switch. When disabled, no SMS will be sent through kwtSMS.">
                            <field name="kwtsms_enabled"/>
                        </setting>
                        <setting id="kwtsms_test_mode_setting"
                                 string="Test Mode"
                                 help="Messages are queued but not delivered. No credits consumed.">
                            <field name="kwtsms_test_mode"/>
                        </setting>
                        <setting id="kwtsms_country_code_setting"
                                 string="Default Country Code"
                                 help="Used for numbers without a country code prefix. Available codes come from your kwtSMS coverage.">
                            <field name="kwtsms_default_country_code"/>
                        </setting>
                        <setting id="kwtsms_retention_setting"
                                 string="Log Retention"
                                 help="Auto-delete SMS logs older than this many days.">
                            <field name="kwtsms_log_retention_days"/> days
                        </setting>
                    </block>

                    <!-- Gateway Settings -->
                    <block title="Gateway Credentials" name="kwtsms_gateway">
                        <setting id="kwtsms_username_setting"
                                 string="API Username">
                            <field name="kwtsms_api_username"/>
                        </setting>
                        <setting id="kwtsms_sender_setting"
                                 string="Sender ID"
                                 help="Select your registered sender ID.">
                            <field name="kwtsms_sender_id"/>
                        </setting>
                        <setting id="kwtsms_password_setting"
                                 string="API Password">
                            <field name="kwtsms_api_password" password="True"/>
                        </setting>
                        <setting id="kwtsms_login_setting"
                                 string="Connection">
                            <!-- Show Login/Verify when NOT connected -->
                            <button name="action_kwtsms_login"
                                    invisible="kwtsms_api_status == 'connected'"
                                    string="Login"
                                    type="object"
                                    class="btn-primary"
                                    icon="fa-sign-in"/>
                            <!-- Show Disconnect when connected -->
                            <button name="action_kwtsms_logout"
                                    invisible="kwtsms_api_status != 'connected'"
                                    string="Logout"
                                    type="object"
                                    class="btn-warning"
                                    icon="fa-sign-out"/>
                            <button name="action_kwtsms_refresh"
                                    string="Refresh"
                                    type="object"
                                    class="btn-secondary ms-2"
                                    icon="fa-refresh"/>
                        </setting>
                    </block>

                    <!-- SMS Notifications -->
                    <block title="SMS Notifications" name="kwtsms_notifications">
                        <setting id="kwtsms_order_confirm_setting"
                                 string="Sales: SMS on Order Confirmation"
                                 help="Automatically send SMS when a sale order is confirmed. Template is auto-selected based on customer language.">
                            <field name="kwtsms_auto_order_confirm"/>
                        </setting>
                        <setting id="kwtsms_delivery_done_setting"
                                 string="Inventory: SMS on Delivery Completion"
                                 help="Automatically send SMS when an outgoing delivery is validated. Template is auto-selected based on customer language.">
                            <field name="kwtsms_auto_delivery_done"/>
                        </setting>
                        <setting id="kwtsms_order_cancel_setting"
                                 string="Sales: SMS on Order Cancellation"
                                 help="Automatically send SMS when a sale order is cancelled. Template is auto-selected based on customer language.">
                            <field name="kwtsms_auto_order_cancel"/>
                        </setting>
                        <setting id="kwtsms_invoice_posted_setting"
                                 string="Accounting: SMS on Invoice Posted"
                                 help="Automatically send SMS when a customer invoice is posted. Template is auto-selected based on customer language.">
                            <field name="kwtsms_auto_invoice_posted"/>
                        </setting>
                        <setting id="kwtsms_payment_received_setting"
                                 string="Accounting: SMS on Payment Received"
                                 help="Automatically send SMS when an inbound payment is posted. Template is auto-selected based on customer language.">
                            <field name="kwtsms_auto_payment_received"/>
                        </setting>
                    </block>

                    <!-- Logs & Templates Links -->
                    <block title="Data" name="kwtsms_data">
                        <setting id="kwtsms_templates_link"
                                 string="SMS Templates"
                                 help="Manage SMS message templates with placeholders.">
                            <button name="%(kwtsms_sms.action_kwtsms_sms_template)d"
                                    string="Manage Templates"
                                    type="action"
                                    class="btn-link"
                                    icon="fa-arrow-right"/>
                        </setting>
                        <setting id="kwtsms_logs_link"
                                 string="SMS Logs"
                                 help="View full SMS audit trail with API responses.">
                            <button name="%(kwtsms_sms.action_kwtsms_sms_log)d"
                                    string="View Logs"
                                    type="action"
                                    class="btn-link"
                                    icon="fa-arrow-right"/>
                        </setting>
                    </block>

                    <!-- Gateway Test -->
                    <block title="Gateway Test" name="kwtsms_gateway_test">
                        <setting id="kwtsms_test_sms_setting"
                                 string="Send Test SMS"
                                 help="Send a test SMS to verify your gateway configuration.">
                            <widget name="kwtsms_test_sms"/>
                        </setting>
                    </block>

                    <!-- Help -->
                    <block title="Help" name="kwtsms_help">
                        <setting id="kwtsms_help_content" string="Resources">
                            <div>
                                <p><strong>Setup Guide:</strong></p>
                                <ol>
                                    <li>Enter your kwtSMS API Username and Password above</li>
                                    <li>Click "Login" to test the connection</li>
                                    <li>Select your Sender ID</li>
                                    <li>Keep Test Mode ON during development</li>
                                    <li>Configure integration triggers (Sales, Inventory)</li>
                                    <li>Switch Test Mode OFF when ready for production</li>
                                </ol>
                                <p><strong>Links:</strong></p>
                                <ul>
                                    <li><a href="https://www.kwtsms.com/login/" target="_blank">kwtSMS Dashboard</a> - Manage your account, view queue, and check balance</li>
                                    <li><a href="https://www.kwtsms.com/faq/" target="_blank">FAQ</a> - Common questions about the kwtSMS service</li>
                                    <li><a href="https://www.kwtsms.com/sender-id-help.html" target="_blank">Sender ID Help</a> - How to register and manage sender IDs</li>
                                    <li><a href="https://www.kwtsms.com/#contact" target="_blank">Contact Support</a> - Get help from the kwtSMS team</li>
                                    <li><a href="https://www.kwtsms.com/integrations.html" target="_blank">Other Integrations</a> - kwtSMS plugins for other platforms</li>
                                </ul>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
