<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Security Groups -->
        <record id="group_kwtsms_manager" model="res.groups">
            <field name="name">kwtSMS Manager</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Full access to kwtSMS Gateway settings, templates, and logs.</field>
        </record>

        <!-- Record Rules: Multi-company isolation -->

        <!-- Log records: users see own company only -->
        <record id="rule_kwtsms_log_company" model="ir.rule">
            <field name="name">kwtSMS Log: Company Isolation</field>
            <field name="model_id" ref="model_kwtsms_sms_log"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids),
            ]</field>
        </record>

        <!-- Template records: users see own company only -->
        <record id="rule_kwtsms_template_company" model="ir.rule">
            <field name="name">kwtSMS Template: Company Isolation</field>
            <field name="model_id" ref="model_kwtsms_sms_template"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids),
            ]</field>
        </record>

        <!-- Gateway config: users see own company only -->
        <record id="rule_kwtsms_gateway_company" model="ir.rule">
            <field name="name">kwtSMS Gateway: Company Isolation</field>
            <field name="model_id" ref="model_kwtsms_gateway_config"/>
            <field name="domain_force">[
                ('company_id', 'in', company_ids),
            ]</field>
        </record>

        <!-- OTP Token: company isolation -->
        <record id="rule_kwtsms_otp_token_company" model="ir.rule">
            <field name="name">kwtSMS OTP Token: Company</field>
            <field name="model_id" ref="model_kwtsms_otp_token"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- OTP Device: company isolation -->
        <record id="rule_kwtsms_otp_device_company" model="ir.rule">
            <field name="name">kwtSMS OTP Device: Company</field>
            <field name="model_id" ref="model_kwtsms_otp_device"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- OTP Device: users see own devices -->
        <record id="rule_kwtsms_otp_device_own" model="ir.rule">
            <field name="name">kwtSMS OTP Device: Own</field>
            <field name="model_id" ref="model_kwtsms_otp_device"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- OTP Log: company isolation -->
        <record id="rule_kwtsms_otp_log_company" model="ir.rule">
            <field name="name">kwtSMS OTP Log: Company</field>
            <field name="model_id" ref="model_kwtsms_otp_log"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
